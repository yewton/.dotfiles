#!/bin/bash
# Claude Code の Ctrl-G 外部エディタ用ワークアラウンド。
#
# Claude Code は GUI エディタかどうかをコマンド名のホワイトリストで判定しており、
# ホワイトリスト外のエディタ（emacsclient 等）を使うと Ctrl-G 押下時に alternate screen
# buffer へ切り替わり、会話ログが隠れてしまう。
# (参照: https://github.com/anthropics/claude-code/issues/20045)
#
# "subl"（Sublime Text）はホワイトリストに含まれているため、この名前のラッパー経由で
# emacsclient を呼ぶことで回避する。

# Gemini CLI 等が自動的に付与する -w や --wait オプションを削除する。
# この環境の emacsclient では -w は --timeout=SECONDS として扱われるため、
# そのまま渡すと後続のファイル名が引数として誤認されてしまう。
# emacsclient はデフォルトで待機するため、これらのオプションは不要。

# Claude Code は Sublime Text 互換の "FILENAME:LINE[:COLUMN]" 形式で渡してくるが、
# emacsclient はこのサフィックス形式を解釈できず、"+LINE[:COLUMN] FILENAME" という
# 別引数形式を要求する（emacsclient --help 参照）。そのため該当パターンを変換する。

args=()
for arg in "$@"; do
  if [[ "$arg" == "-w" || "$arg" == "--wait" ]]; then
    continue
  fi
  if [[ "$arg" =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
    args+=("+${BASH_REMATCH[2]}:${BASH_REMATCH[3]}" "${BASH_REMATCH[1]}")
  elif [[ "$arg" =~ ^(.+):([0-9]+)$ ]]; then
    args+=("+${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}")
  else
    args+=("$arg")
  fi
done

exec emacsclient "${args[@]}"
